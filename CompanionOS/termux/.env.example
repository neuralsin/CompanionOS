# CompanionOS - Environment Variables
# Copy this file to .env and fill in your real credentials.
# Do NOT commit your actual .env file to version control.

# --- Spotify Integration ---
# Get these at developer.spotify.com
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# --- GitHub Integration ---
# For displaying profile stats. Get read-only token at github.com/settings/tokens
GITHUB_USERNAME=your_github_username_here
GITHUB_TOKEN=your_github_personal_access_token_here
